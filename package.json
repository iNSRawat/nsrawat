{
  "name": "nsrawat.in",
  "version": "1.1.0",
  "description": "A minimal, pixel-perfect dev portfolio, component registry, and blog.",
  "homepage": "https://nsrawat.in",
  "license": "MIT",
  "author": {
    "name": "N S Rawat",
    "email": "digital@nsrawat.in",
    "url": "https://github.com/iNSRawat"
  },
  "contributors": [
    {
      "name": "N S Rawat",
      "email": "digital@nsrawat.in",
      "url": "https://github.com/iNSRawat"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iNSRawat/nsrawat.git"
  },
  "scripts": {
    "dev": "next dev -p 1360 --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 1360",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check-types": "bunx tsc --noEmit --pretty",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "registry:internal:build": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/build-registry.mts",
    "registry:build": "bun run registry:internal:build && bunx --bun shadcn build ./src/__registry__/registry.autogenerated.json",
    "capture": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/capture.mts",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator ./src/assets/libphonenumber.metadata.json --countries VN --extended",
    "upgrade:next": "npx @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "npx @tailwindcss/upgrade@latest",
    "docker:build": "docker build -t nsrawat-portfolio .",
    "docker:run": "docker run -p 1360:1360 --env-file .env.local nsrawat-portfolio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@bprogress/next": "3.2.12",
    "@c15t/nextjs": "1.8.6",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.7.1",
    "@ncdai/react-wheel-picker": "1.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@supabase/supabase-js": "2.112.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "fumadocs-core": "16.14.0",
    "geist": "1.7.2",
    "jotai": "2.20.2",
    "libphonenumber-js": "1.13.10",
    "lucide-react": "1.28.0",
    "motion": "12.43.0",
    "next": "16.3.0",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "nuqs": "2.9.4",
    "posthog-js": "1.410.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-marquee": "1.6.5",
    "react-hook-form": "7.84.0",
    "react-hotkeys-hook": "5.3.3",
    "react-markdown": "10.1.0",
    "react-medium-image-zoom": "5.4.8",
    "react-use": "17.6.1",
    "recharts": "3.10.1",
    "schema-dts": "2.0.0",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "vcard-creator": "0.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
