    "shiki": "4.4.1",
    "strip-indent": "4.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.8.2",
    "unist-builder": "4.0.0",
    "unist-util-visit": "5.1.0"
  },
  "resolutions": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
